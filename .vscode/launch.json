{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Backend",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--reload"
            ],
            "pythonPath": "${workspaceFolder}/venv/bin/python"
        },
        {
            "name": "Frontend Dev Server",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "npm: dev",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": ["FastAPI Backend", "Frontend Dev Server"]
        }
    ]
}